# Copy this file to .env and insert your gateway API key.
# All models use the same OpenAI-compatible Chat Completions interface.
API_KEY=
BASE_URL=https://api.relaymodels.com/v1
# Use an exact model ID from the gateway catalog, without a provider prefix.
LLM_MODEL=gpt-5.6-luna
# Use an exact image model ID from the gateway catalog.
IMAGE_MODEL=gpt-image-1-mini
# Image API calls are disabled by default because the current gateway has no image models.
IMAGE_GENERATION_ENABLED=false
# PDFs are written under this directory in the repository.
OUTPUT_DIR=generated_cvs
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=cv_candidates
